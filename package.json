{
  "name": "threejs-fps-game",
  "version": "1.0.0",
  "description": "A production-ready Three.js FPS game template with modular architecture, physics, AI, and audio systems",
  "type": "module",
  "main": "src/main_modular.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "vite build --mode analyze",
    "clean": "rm -rf dist node_modules/.vite",
    "predeploy": "npm run build:production",
    "deploy": "gh-pages -d dist"
  },
  "keywords": [
    "threejs",
    "fps",
    "game",
    "webgl",
    "javascript",
    "gamedev",
    "3d"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/threejs-fps-game.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/threejs-fps-game/issues"
  },
  "homepage": "https://yourusername.github.io/threejs-fps-game/",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "gsap": "^3.12.7",
    "lil-gui": "^0.20.0",
    "three": "^0.173.0",
    "three-mesh-bvh": "^0.9.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "gh-pages": "^6.1.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "vite": "^6.1.0",
    "vitest": "^1.6.0"
  }
}
